# Секретные файлы — НИКОГДА не коммитить!
.env
.env.prod
.env.local
.env.production
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
dist/
.pytest_cache/

# Node.js
node_modules/
.next/
.turbo/
out/

# Логи
*.log
logs/

# Docker volumes данные (локальные)
postgres_data/
redis_data/

# IDE
.idea/
.vscode/
*.swp

# OS
.DS_Store
Thumbs.db

# Реальные пилотные данные — НИКОГДА не коммитить (только локальная диагностика)
docs/pilot-data/raw/
