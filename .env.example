# ============================================================
#  Energy Copilot AI — Environment Variables
#  
#  ИНСТРУКЦИЯ:
#  1. Скопируй этот файл: cp .env.example .env
#  2. Заполни секретные значения (отмечены ★)
#  3. Никогда не коммить .env в Git!
# ============================================================

# ── БАЗА ДАННЫХ PostgreSQL ───────────────────────────────────
# Название базы данных
POSTGRES_DB=energy_copilot

# Имя пользователя БД
POSTGRES_USER=ec_user

# ★ Пароль БД — обязательно замени на сложный пароль
POSTGRES_PASSWORD=ec_secret_password

# ── REDIS ────────────────────────────────────────────────────
# ★ Пароль Redis
REDIS_PASSWORD=ec_redis_password

# ── QDRANT (векторная БД для AI) ─────────────────────────────
# ★ API ключ для Qdrant
QDRANT_API_KEY=ec_qdrant_key

# ── MQTT (IoT брокер) ────────────────────────────────────────
# Пользователь MQTT
MQTT_USER=ec_mqtt

# ★ Пароль MQTT
MQTT_PASSWORD=ec_mqtt_password

# ── БЕЗОПАСНОСТЬ ─────────────────────────────────────────────
# ★ Секретный ключ для JWT токенов
# Сгенерируй командой: openssl rand -hex 32
SECRET_KEY=change_this_in_production_very_long_secret_key_min_32_chars

# Алгоритм подписи JWT
JWT_ALGORITHM=HS256

# Время жизни access токена (в минутах)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Время жизни refresh токена (в днях)
REFRESH_TOKEN_EXPIRE_DAYS=30

# ── AI ПРОВАЙДЕРЫ ────────────────────────────────────────────
# Какой AI провайдер использовать по умолчанию
# Варианты: openai | anthropic | gemini | local
DEFAULT_AI_PROVIDER=openai

# ★ OpenAI API ключ (получить: https://platform.openai.com)
OPENAI_API_KEY=sk-...

# ★ Anthropic (Claude) API ключ (получить: https://console.anthropic.com)
ANTHROPIC_API_KEY=sk-ant-...

# ★ Google Gemini API ключ (получить: https://makersuite.google.com)
GEMINI_API_KEY=...

# Модель для генерации ответов
OPENAI_MODEL=gpt-4o-mini

# Модель для создания embeddings (векторов из текста)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── ПРОГНОЗИРОВАНИЕ (Forecast Intelligence Engine) ───────────
# Провайдер погодных данных по умолчанию
# Варианты: mock | solcast | meteologix | ecmwf | noaa | meteoblue
DEFAULT_WEATHER_PROVIDER=mock

# API ключи погодных провайдеров (добавить позже)
SOLCAST_API_KEY=
METEOLOGIX_API_KEY=
ECMWF_API_KEY=

# ── УВЕДОМЛЕНИЯ (опционально) ────────────────────────────────
# SMTP для отправки email уведомлений
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ── ОКРУЖЕНИЕ ────────────────────────────────────────────────
# Варианты: development | staging | production
ENVIRONMENT=development

# Уровень логирования: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=DEBUG

# ── CORS ─────────────────────────────────────────────────────
# Разрешённые домены для CORS (через запятую)
CORS_ORIGINS=http://localhost:3000,http://localhost:80

# ── ИНТЕРНАЦИОНАЛИЗАЦИЯ ──────────────────────────────────────
# Язык интерфейса по умолчанию: ru | kk | en
DEFAULT_LANGUAGE=ru
