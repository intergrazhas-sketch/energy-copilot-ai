# Energy Copilot AI production environment template.
# Copy to .env.prod on the server and fill real values there.
# Do not commit .env.prod.

POSTGRES_DB=energy_copilot_prod
POSTGRES_USER=energy_copilot_user
POSTGRES_PASSWORD=

REDIS_PASSWORD=
QDRANT_API_KEY=

DATABASE_URL=postgresql+asyncpg://energy_copilot_user:<POSTGRES_PASSWORD>@postgres:5432/energy_copilot_prod
REDIS_URL=redis://:<REDIS_PASSWORD>@redis:6379/0

SECRET_KEY=
ENVIRONMENT=production
LOG_LEVEL=INFO

# Host port that publishes the API container (container port 8000).
# Keep 8010 so it never collides with PetroAI on 8000.
API_HOST_PORT=8010

# Comma-separated frontend origins allowed by FastAPI CORS.
# Must include the public Netlify URL and the direct API origin used by the demo.
# Example: https://visionary-brigadeiros-5747af.netlify.app,http://111.88.140.213:8010
CORS_ORIGINS=https://visionary-brigadeiros-5747af.netlify.app,http://111.88.140.213:8010

# The first pilot deploy uses CSV/API data paths. MQTT broker is not included in production compose.
MQTT_ENABLED=false

# Keep the default unless the demo uses fresh telemetry timestamps.
ALERT_TELEMETRY_CRITICAL_MINUTES=120
